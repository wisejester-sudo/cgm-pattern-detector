# Dispatchly Environment Configuration
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to Git

# ============================================
# SUPABASE CONFIGURATION (Required)
# ============================================
# Get these from your Supabase project settings:
# https://app.supabase.com/project/_/settings/api

# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ⚠️ IMPORTANT: Service role key is SERVER-SIDE ONLY
# Never expose this in client-side code or commit to Git
# Only use in secure API routes (e.g., admin operations, data migrations)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ============================================
# TWILIO CONFIGURATION (Required for SMS)
# ============================================
# Get these from your Twilio Console:
# https://www.twilio.com/console

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Base URL for the application
# Development:
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_APP_URL=https://your-domain.com

# ============================================
# CRON JOB SECURITY (Required for photo cleanup)
# ============================================
# Secret key to secure cron job endpoints
# Generate with: openssl rand -hex 32
# Must match the Authorization: Bearer header sent by Vercel Cron
CRON_SECRET=your_random_secret_key_here

# ============================================
# OPTIONAL: PHOTO LINK SECURITY
# ============================================
# Secret for generating secure photo viewing links
# Generate with: openssl rand -hex 32
PHOTO_LINK_SECRET=your_photo_link_secret_here
MAGIC_LINK_SECRET=your_magic_link_secret_here

# ============================================
# OPTIONAL: MONITORING & ANALYTICS
# ============================================

# Sentry Configuration (optional but recommended)
# Get from: https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# Vercel Analytics (auto-configured on Vercel)
# No additional config needed for basic analytics

# ============================================
# SECURITY NOTES
# ============================================
# 1. NEVER commit .env.local to Git
# 2. NEVER expose SUPABASE_SERVICE_ROLE_KEY client-side
# 3. Rotate credentials if accidentally exposed
# 4. Use different keys for development vs production
# 5. Enable Row Level Security (RLS) in Supabase
